
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wxpe-db
POSTGRES_USER=wxpe
POSTGRES_PASSWORD=tongrang123wxpe

# 测量服务 API 配置
MEASUREMENT_API_URL=http://backend-service:3000/api/measurements 

# Image tag
TAG=latest

# Port mapping
HOST_PORT=8080
WS_PORT=8080

# For 192.168.1.108
# 您可以根据需要取消注释并配置这些变量
SERIAL_PORT=COM3
ALARM_WITH_SOUND=true

# For udp-server
LIGHT_ACTIVE=true

# Common variables for services
WS_SERVER=ws://websocket-server:8080

# For frontend (server-side variables used by API routes)
WEBSOCKET_SERVER=ws://websocket-server:8080
HTTP_SERVER=http://backend-service:3000

# 注意：NEXT_PUBLIC_ 变量在构建时通过 Dockerfile ARG 设置，不需要在这里定义

# ==================== TCP 服务配置 ====================
# TCP服务器监听端口
TCP_PORT=8999

# TCP处理队列大小（最大排队数据包数量）
TCP_QUEUE_SIZE=1000

# TCP最大并发处理数量
TCP_MAX_HANDLERS=5

# ==================== WebSocket 配置 ====================
# WebSocket服务器地址（已在上面定义，这里删除重复）

# ==================== API 服务配置 ====================
# API服务基础URL
API_BASE_URL=http://backend-service:3000/api

# API端点路径
API_PARAMETERS=/parameters
API_MEASUREMENTS=/measurements
API_QUALITY=/quality-records

# ==================== 日志配置 ====================
# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# ==================== 环境配置示例 ====================

# 开发环境配置示例:
# LOG_LEVEL=debug

# 生产环境配置示例:
# LOG_LEVEL=info

# 调试环境配置示例:
# LOG_LEVEL=debug 